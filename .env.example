# Tool-schema language: en or zh-CN
THINKING_PROMPT_LANGUAGE=en

# Thinking content is not saved unless capture is explicitly enabled.
CAPTURE_ENABLED=0

# --- Network boundary ---
# This server authenticates nothing by default. Everything below stays closed
# until you open it deliberately.

# Address the server binds to. Loopback by default. Under docker-compose this is
# set to 0.0.0.0 inside the container and the exposure boundary is the port
# mapping instead.
# MCP_BIND=127.0.0.1

# Shared secret required as `Authorization: Bearer <token>`. Only works with
# clients that can set a header: curl, your own code, MCP clients with
# custom-header support. ChatGPT connectors cannot send it (OAuth or nothing).
# MCP_AUTH_TOKEN=

# Extra hostnames this server may be addressed by, comma separated. localhost
# and 127.0.0.1 are always allowed. A leading "*." matches any subdomain, which
# is what ephemeral tunnels need since their hostname changes on every restart.
# MCP_ALLOWED_HOSTS=*.trycloudflare.com

# Browser origins allowed to call this server, comma separated. Leave empty
# unless a specific web origin needs access; an empty list blocks every
# cross-site page.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Honour X-Forwarded-Host / X-Forwarded-Proto. Enable ONLY when a proxy you
# control sets them, otherwise callers can choose the URL this server advertises.
# MCP_TRUST_PROXY=0
